# ─────────────────────────────────────────────────────────────
#  Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed site (canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Live AI chatbot (optional) ──
# Without a key, the chatbot runs in a clearly-labelled scripted demo mode.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5)
# CHAT_MODEL=claude-opus-5-5

# ── Enquiry delivery (configure at least one) ──
# Email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=you@yourbusiness.com
ENQUIRY_FROM_EMAIL="Website Enquiries <enquiries@yourdomain.com>"

# Webhook (e.g. an n8n Webhook node, Zapier, Make). Receives JSON.
ENQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header
ENQUIRY_WEBHOOK_SECRET=

# ── Sanity CMS (optional) ──
# Without these, the site uses the built-in content in src/content/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token (server-only): reads a private dataset and saves enquiries to the Studio
SANITY_API_TOKEN=
# Optional: instant updates via a Sanity webhook pointed at /api/revalidate
SANITY_REVALIDATE_SECRET=
